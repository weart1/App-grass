# Server settings for deploy/docker-compose.yml.
# On the server: cp .env.example .env && nano .env
# This file holds secrets — never commit deploy/.env.

# Domain that points to this server (DNS "A" record), e.g. api.myleafy.com
API_DOMAIN=

# Database password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App settings (same names as apps/api/.env.example) ---------------
AI_PROVIDER=mock
RUNWARE_API_KEY=

# Generate: openssl rand -base64 32
AUTH_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Generate: openssl rand -hex 24
CRON_SECRET=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=

# --- Server integration ------------------------------------------------
# Local port the API listens on (nginx proxies to 127.0.0.1:API_PORT).
# Must not clash with other apps on the server (3000–3002 and 3100 are taken there).
API_PORT=3010
# Uncomment ONLY on a server with nothing else on ports 80/443 (built-in HTTPS via Caddy).
# COMPOSE_PROFILES=caddy
