# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables
# (Neon, Blob and Upstash values are injected automatically by their
# Vercel Marketplace integrations).

# --- AI ---------------------------------------------------------------
# "mock" returns fixed realistic reports (no Runware credits spent).
AI_PROVIDER=mock
RUNWARE_API_KEY=

# --- Data -------------------------------------------------------------
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Better Auth, see DECISIONS.md D-003) -----------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of this API, e.g. https://leafy-api.vercel.app
AUTH_URL=http://localhost:3000
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional email for one-time sign-in codes
RESEND_API_KEY=
EMAIL_FROM="Leafy <hello@example.com>"

# --- Jobs & push ------------------------------------------------------
CRON_SECRET=
EXPO_ACCESS_TOKEN=

# --- Observability (Phase 8) -----------------------------------------
SENTRY_DSN=
