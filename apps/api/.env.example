# Copy to .env.local for local development. Never commit real values.
# On the DigitalOcean server these live in /opt/leafy/.env (see DECISIONS.md D-021).

# --- AI ---------------------------------------------------------------
# "mock" returns fixed realistic reports (no Runware credits spent).
AI_PROVIDER=mock
RUNWARE_API_KEY=

# --- Data (all on the VPS) --------------------------------------------
DATABASE_URL=postgres://leafy:leafy@localhost:5432/leafy
REDIS_URL=redis://localhost:6379

# --- Photo storage: DigitalOcean Spaces (S3-compatible) ---------------
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (or its CDN), e.g. https://leafy.fra1.cdn.digitaloceanspaces.com
S3_PUBLIC_URL=

# --- Auth: Better Auth + Google sign-in (D-003) ------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public HTTPS address of this API, e.g. https://api.your-domain.com
AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials (OAuth client IDs)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Jobs & push ------------------------------------------------------
CRON_SECRET=
EXPO_ACCESS_TOKEN=

# --- Observability (Phase 8) -----------------------------------------
SENTRY_DSN=
